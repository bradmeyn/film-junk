---
import Layout from '../../layouts/layout.astro';
import FilmBrowser, { type Item } from '../../components/film-browser.svelte';
import { episodeHref, episodeLabel, episodes, filmBySlug, films, formatDate } from '../../lib/data';

// Every review, for the browser. "6 out of 5" counts as 5 in the average, as everywhere else on the site.
const items: Item[] = episodes.flatMap((e) =>
	(e.reviews ?? []).map((review) => {
		const film = review.film ? filmBySlug.get(review.film) : undefined;
		const capped = review.ratings.map((r) => Math.min(5, (r.score / r.outOf) * 5));
		return {
			k: `${e.id}:${review.film ?? review.title}`,
			f: film?.slug ?? null,
			t: film?.title ?? review.title,
			y: film?.year ?? review.year,
			p: film?.poster ?? null,
			e: episodeHref(e),
			l: `${episodeLabel(e)}, ${formatDate(e.date, e.dateApprox)}`,
			d: e.date,
			r: review.ratings.map((r) => ({ h: r.host, s: r.score, o: r.outOf })),
			a: capped.length ? capped.reduce((a, b) => a + b, 0) / capped.length : null,
		};
	}),
);

// Regular hosts first, then guests by how often they rated something.
const hostCounts = new Map<string, number>();
for (const i of items) for (const r of i.r) hostCounts.set(r.h, (hostCounts.get(r.h) ?? 0) + 1);
const hosts = [...hostCounts].filter(([, n]) => n >= 5).sort((a, b) => b[1] - a[1]).map(([h]) => h);

const reviewCount = (f: (typeof films)[number]) => f.appearances.filter((a) => a.role !== 'watched').length;
const mostReviewed = films
	.filter((f) => reviewCount(f) > 1)
	.sort((a, b) => reviewCount(b) - reviewCount(a))
	.slice(0, 30);
const mostMentioned = films
	.map((f) => ({ f, n: f.appearances.filter((a) => a.role === 'watched').length }))
	.sort((a, b) => b.n - a.n)
	.slice(0, 30);
---

<Layout title="Films and TV" description={`Search ${films.length.toLocaleString()} movies and TV shows reviewed or discussed on the Film Junk Podcast, and find the episode.`}>
	<div class="wrap">
		<h1>Films</h1>
		<p class="muted intro">
			All {items.length.toLocaleString()} reviews. Filter by rating to find the favourites, or the ones nobody liked. To find any of
			the {films.length.toLocaleString()} films and shows mentioned on the podcast, use the search at the top.
		</p>
		<div class="browser">
			<FilmBrowser client:load {items} {hosts} />
		</div>

		<div class="lists">
			<section>
				<h2>Reviewed more than once</h2>
				<ol>
					{
						mostReviewed.map((f) => (
							<li>
								<a href={`/films/${f.slug}/`}>{f.title}</a> <span class="muted">{reviewCount(f)} times</span>
							</li>
						))
					}
				</ol>
			</section>
			<section>
				<h2>Watched the most</h2>
				<ol>
					{
						mostMentioned.map(({ f, n }) => (
							<li>
								<a href={`/films/${f.slug}/`}>{f.title}</a> <span class="muted">{n} episodes</span>
							</li>
						))
					}
				</ol>
			</section>
		</div>
	</div>
</Layout>

<style>
	h1 {
		font-size: var(--step-3);
		margin-top: 1.5rem;
	}

	.intro {
		max-width: 55ch;
	}

	.browser {
		margin-bottom: 3.5rem;
	}

	.lists {
		display: grid;
		gap: 2.5rem;
		grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
	}

	h2 {
		font-size: var(--step-2);
		margin-bottom: 0.75rem;
	}

	ol {
		margin: 0;
		padding-left: 1.75rem;
		display: grid;
		gap: 0.3rem;
	}

	li a {
		font-weight: 600;
	}

	li span {
		font-size: var(--step--1);
	}
</style>

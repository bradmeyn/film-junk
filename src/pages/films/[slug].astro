---
import Layout from '../../layouts/layout.astro';
import EpisodeRow from '../../components/episode-row.astro';
import Stars from '../../components/stars.astro';
import Icon from '../../components/icon.astro';
import FilmPosters from '../../components/film-posters.astro';
import { filmSchema } from '../../lib/schema';
import {
	byDiscussion,
	directorHref,
	directors,
	episodeById,
	episodeHref,
	episodeLabel,
	filmLinks,
	films,
	formatDate,
	formatRuntime,
	hostHref,
	posterUrl,
	type Episode,
	type Film,
} from '../../lib/data';

export function getStaticPaths() {
	return films.map((film) => ({ params: { slug: film.slug }, props: { film } }));
}

interface Props {
	film: Film;
}
const { film } = Astro.props;

const byRole = (role: string) =>
	film.appearances
		.filter((a) => a.role === role)
		.map((a) => episodeById.get(a.id)!)
		.filter(Boolean)
		.sort((a, b) => b.date.localeCompare(a.date));

const reviewed = byRole('review').map((e) => ({
	episode: e,
	review: e.reviews?.find((r) => r.film === film.slug),
}));
const premiums = byRole('premium');
const featured = new Set([...reviewed.map((r) => r.episode.id), ...premiums.map((e) => e.id)]);
const watched = byRole('watched').filter((e) => !featured.has(e.id));

// Other films by the same director(s) that came up on the show.
const MORE = 12;
const more = (film.directors ?? [])
	.map((d) => directors.get(d.slug))
	.filter((d) => d !== undefined)
	.map((d) => ({ director: d, films: d.films.filter((f) => f.slug !== film.slug).sort(byDiscussion) }))
	.filter((d) => d.films.length);
const credit = film.tmdb?.type === 'tv' ? 'Created by' : 'Directed by';
const runtime = formatRuntime(film.runtime);
const facts = [runtime && (film.tmdb?.type === 'tv' ? `${runtime} episodes` : runtime), film.genres?.join(', ')].filter(Boolean);

const poster = posterUrl(film.poster, 'w342');
const links = filmLinks(film);
const heading = film.year ? `${film.title} (${film.year})` : film.title;
const summary = [
	reviewed.length && `reviewed ${reviewed.length === 1 ? 'once' : `${reviewed.length} times`}`,
	premiums.length && `covered in ${premiums.length} premium${premiums.length === 1 ? '' : 's'}`,
	watched.length && `came up in ${watched.length} other episode${watched.length === 1 ? '' : 's'}`,
]
	.filter(Boolean)
	.join(', ');
// Search snippet: the latest verdict first, since that's what people are looking for.
const latestRatings = reviewed[0]?.review?.ratings.map((r) => `${r.host} ${r.score}/${r.outOf}`).join(', ');
const kindWord = film.tmdb?.type === 'tv' ? 'TV review' : 'movie review';
const pageTitle = reviewed.length ? `${heading} review` : heading;
const pageDescription = reviewed.length
	? `Film Junk Podcast ${kindWord} of ${heading}${latestRatings ? `: ${latestRatings}` : ''}. On the show: ${summary}.`
	: `${heading} on the Film Junk Podcast: ${summary}.`;
---

<Layout
	title={pageTitle}
	description={pageDescription}
	image={posterUrl(film.poster, 'w500')}
	type="video.movie"
	schema={filmSchema(film, reviewed, Astro.site)}
>
	<div class="wrap">
		<header class:list={[{ 'has-poster': poster }]}>
			{poster && <img src={poster} alt={`Poster for ${heading}`} width="342" height="513" />}
			<div>
				<h1>{heading}</h1>
				{
					(film.directors?.length || facts.length > 0) && (
						<p class="credits">
							{film.directors?.length && (
								<span>
									{credit}{' '}
									{film.directors.map((d, i) => (
										<>
											{i > 0 && (i === film.directors!.length - 1 ? ' and ' : ', ')}
											{directorHref(d.slug) ? <a href={directorHref(d.slug)}>{d.name}</a> : d.name}
										</>
									))}
								</span>
							)}
							{facts.map((f) => (
								<span>{f}</span>
							))}
						</p>
					)
				}
				<p class="summary">On Film Junk: {summary}.</p>
				{
					links.length > 0 && (
						<p class="external">
							{links.map((l) => (
								<a class="button" href={l.url}>
									<Icon name={l.icon} /> {l.label}
								</a>
							))}
						</p>
					)
				}
			</div>
		</header>

		{film.overview && <p class="overview">{film.overview}</p>}

		{
			reviewed.length > 0 && (
				<section>
					<h2>Reviewed</h2>
					<ul class="reviews">
						{reviewed.map(({ episode: e, review }) => (
							<li>
								<a class="ep" href={episodeHref(e)}>
									<span class="sticker" data-kind={e.kind}>
										{e.kind === 'regular' && e.number ? e.number : { premium: 'Premium', patreon: 'Patreon', bonus: 'Bonus', regular: 'Episode' }[e.kind]}
									</span>
									<span>
										<strong>{episodeLabel(e)}</strong>
										<span class="muted"> {formatDate(e.date, e.dateApprox)}</span>
										{e.title !== review?.title && <span class="also">{e.title}</span>}
									</span>
								</a>
								{review && review.ratings.length > 0 && (
									<dl class="ratings">
										{review.ratings.map((x) => (
											<div>
												<dt>{hostHref(x.host) ? <a href={hostHref(x.host)}>{x.host}</a> : x.host}</dt>
												<dd>
													<Stars score={x.score} outOf={x.outOf} />
												</dd>
											</div>
										))}
									</dl>
								)}
							</li>
						))}
					</ul>
				</section>
			)
		}

		{
			premiums.length > 0 && (
				<section>
					<h2>Premium episodes</h2>
					<ul class="list">
						{premiums.map((e: Episode) => (
							<EpisodeRow episode={e} />
						))}
					</ul>
				</section>
			)
		}

		{
			watched.length > 0 && (
				<section>
					<h2>Also came up in</h2>
					<p class="muted note">Episodes where it came up: something a host watched, or a film the episode talks about.</p>
					<ul class="list">
						{watched.map((e: Episode) => (
							<EpisodeRow episode={e} />
						))}
					</ul>
				</section>
			)
		}

		{
			more.map(({ director, films }) => (
				<section class="more">
					<div class="section-head">
						<h2>More from {director.name}</h2>
						<a href={directorHref(director.slug)}>
							All {director.films.length} films on Film Junk
						</a>
					</div>
					<FilmPosters films={films.slice(0, MORE)} />
				</section>
			))
		}
	</div>
</Layout>

<style>
	header {
		padding-block: 1.5rem 1rem;
	}

	header.has-poster {
		display: grid;
		grid-template-columns: minmax(7rem, 12rem) 1fr;
		gap: 1.5rem;
		align-items: end;
	}

	header img {
		width: 100%;
		height: auto;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		border-radius: var(--radius);
		background: var(--line);
	}

	.external {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1rem 0 0;
	}

	h1 {
		font-size: var(--step-4);
		line-height: 1.1;
		max-width: 20ch;
		overflow-wrap: break-word;
	}

	@media (max-width: 40rem) {
		header.has-poster {
			grid-template-columns: 6.5rem 1fr;
			gap: 1rem;
			align-items: start;
		}

		h1 {
			font-size: var(--step-3);
		}

		.summary {
			font-size: var(--step-0);
			margin-top: 0.5rem;
		}
	}

	.summary {
		font-size: var(--step-1);
		margin: 1rem 0 0;
	}

	.credits {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.5rem;
		margin: 0.75rem 0 0;
		color: var(--muted);
	}

	.credits span + span::before {
		content: '·';
		margin-right: 0.5rem;
	}

	.credits a {
		color: var(--ink);
		font-weight: 600;
	}

	.overview {
		max-width: 50rem;
		margin: 1.5rem 0 0;
		font-size: var(--step-0);
		line-height: 1.6;
	}

	section.more {
		max-width: none;
	}

	.section-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.25rem 1rem;
		margin-bottom: 0.75rem;
	}

	.section-head h2 {
		margin: 0;
	}

	section {
		margin-top: 2.5rem;
		max-width: 50rem;
	}

	h2 {
		font-size: var(--step-2);
		margin-bottom: 0.75rem;
	}

	.note {
		margin: -0.25rem 0 0.5rem;
	}

	.list,
	.reviews {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.reviews li {
		padding: 1rem 0;
		border-top: 1px solid var(--line);
		display: grid;
		gap: 0.75rem;
	}

	.reviews li + li {
		margin-top: 0.75rem;
	}

	.ep {
		display: flex;
		gap: 1rem;
		align-items: center;
		text-decoration: none;
	}

	.ep:hover strong {
		text-decoration: underline;
	}

	.also {
		display: block;
		font-size: var(--step--1);
		color: var(--muted);
	}

	.ratings {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		margin: 0;
	}

	.ratings div {
		display: flex;
		gap: 0.5rem;
		align-items: baseline;
	}

	dt {
		font-weight: 600;
	}

	dd {
		margin: 0;
	}
</style>

---
import Layout from '../layouts/layout.astro';
import { homeSchema } from '../lib/schema';
import ListenLinks from '../components/listen-links.astro';
import EpisodeRow from '../components/episode-row.astro';
import Stars from '../components/stars.astro';
import Icon from '../components/icon.astro';
import PackCard from '../components/pack-card.astro';
import { episodeArt, episodes, episodeHref, episodeLabel, formatDate, films, hostHref, HOSTS, LINKS, meta, posterUrl } from '../lib/data';

const latest = episodes.find((e) => e.kind === 'regular')!;
const latestArt = episodeArt(latest);
const premiums = episodes.filter((e) => e.kind === 'premium' && e.art).slice(0, 6);

// This month's schedule, or the latest one posted.
const thisMonth = new Date().toISOString().slice(0, 7);
const schedule = meta.schedule.find((m) => m.month === thisMonth) ?? meta.schedule[0];
const scheduleName = schedule && new Date(schedule.month + '-01T00:00:00Z').toLocaleString('en-US', { month: 'long', timeZone: 'UTC' });
const dayFormat = new Intl.DateTimeFormat('en-US', { weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC' });
const day = (iso: string) => dayFormat.format(new Date(iso + 'T00:00:00Z'));

// "This month in history" is fixed at build time; the site rebuilds daily.
const now = new Date();
const month = String(now.getUTCMonth() + 1).padStart(2, '0');
const monthName = now.toLocaleString('en-US', { month: 'long', timeZone: 'UTC' });
const thisYear = String(now.getUTCFullYear());
const history = Object.entries(
	Object.groupBy(
		episodes.filter((e) => e.date.slice(5, 7) === month && e.date.slice(0, 4) !== thisYear && !e.dateApprox),
		(e) => e.date.slice(0, 4)
	)
).sort(([a], [b]) => b.localeCompare(a));

const premiumCount = episodes.filter((e) => e.kind === 'premium').length;
const patreonLatest = episodes.filter((e) => e.kind === 'patreon');
const patreonCount = patreonLatest.length;
const blurb = latest.description.length > 420 ? latest.description.slice(0, 420).replace(/\s\S*$/, '') + '…' : latest.description;
---

<Layout
	title="The Longest Running Film Podcast"
	description={`Movie reviews, TV talk and film news since 2005. Search ${films.length.toLocaleString()} films across every Film Junk Podcast episode, premium and Patreon exclusive.`}
	schema={homeSchema(Astro.site)}
>
	<section class="hero wrap">
		<img class="hero-logo" src="/logo-512.jpg" alt="Film Junk logo" width="512" height="512" />
		<div class="about">
			<h1>The Longest Running Film Podcast</h1>
			<p class="lede">An unofficial companion to the Film Junk Podcast, {latest.number!.toLocaleString()} episodes and counting.</p>
			<div class="hosts">
				<h2>Hosted by</h2>
				<ul>
					{
						HOSTS.map((h) => (
							<li>
								<a class="host-name" href={`/hosts/${h.slug}/`}>{h.name}</a>
								<span class="host-links">
									{h.links.map((l) => (
										<a href={l.url} title={`${h.name.split(' ')[0]}'s ${l.label}`}>
											<Icon name={l.icon} />
											<span>{l.label}</span>
										</a>
									))}
								</span>
							</li>
						))
					}
				</ul>
			</div>
			<p class="listen">
				<a class="button big patreon" href={LINKS.patreon}><Icon name="patreon" /> Support on Patreon</a>
				<a class="button big spotify" href={LINKS.spotify}><Icon name="spotify" /> Listen on Spotify</a>
				<a class="button big" href={LINKS.apple} aria-label="Listen on Apple Podcasts"><Icon name="apple" /> Listen on Apple</a>
			</p>
		</div>
	</section>

	{
		schedule && (
			<section class="wrap schedule" aria-labelledby="schedule-h">
				<div class="section-head">
					<h2 id="schedule-h">{scheduleName} on Film Junk</h2>
					{schedule.source && (
						<a href={schedule.source}>
							<Icon name="instagram" /> Calendar on Instagram
						</a>
					)}
				</div>
				{schedule.note && <p class="muted packs-intro">{schedule.note}</p>}
				<ol>
					{schedule.items.map((item) => {
						const href = item.episode ? `/episodes/${item.episode}/` : item.film ? `/films/${item.film}/` : null;
						const Tag = href ? 'a' : 'div';
						return (
							<li>
								<Tag class="slot" href={href ?? undefined} data-status={item.status}>
									{item.poster ? (
										<img src={posterUrl(item.poster, 'w342')} alt="" width="342" height="513" loading="lazy" />
									) : (
										<span class="no-poster" aria-hidden="true" />
									)}
									<span class="when">{day(item.date)}</span>
									<span class="what">
										{item.title}
										{item.year && <span class="muted"> ({item.year})</span>}
									</span>
									<span class="status">
										{item.status === 'out' ? 'Out now' : item.status === 'patreon' ? 'On Patreon now' : 'Coming up'}
									</span>
								</Tag>
							</li>
						);
					})}
				</ol>
			</section>
		)
	}

	<div class="wrap split">
		<section class="latest" aria-labelledby="latest-h">
			<h2 id="latest-h">Latest episode</h2>
			<article class:list={[{ 'has-art': latestArt }]}>
				{latestArt && <img class="latest-art" src={latestArt.src} alt="" width="500" height="750" />}
				<div class="latest-body">
				<span class="sticker">{episodeLabel(latest)}</span>
				<h3><a href={episodeHref(latest)}>{latest.title}</a></h3>
				<p class="muted"><time datetime={latest.date}>{formatDate(latest.date)}</time></p>
				{blurb && <p class="blurb">{blurb}</p>}
				{
					latest.reviews?.some((r) => r.ratings.length) && (
						<ul class="ratings">
							{latest.reviews.flatMap((r) =>
								r.ratings.map((x) => (
									<li>
										<span>{hostHref(x.host) ? <a href={hostHref(x.host)}>{x.host}</a> : x.host}</span> <Stars score={x.score} outOf={x.outOf} label={x.host} />
									</li>
								))
							)}
						</ul>
					)
				}
				<ListenLinks episode={latest} />
				</div>
			</article>
		</section>

		<section class="history" aria-labelledby="history-h">
			<h2 id="history-h">{monthName} in Film Junk history</h2>
			<dl>
				{
					history.map(([year, eps]) => (
						<div class="year">
							<dt>
								<a href={`/years/${year}/`}>{year}</a>
							</dt>
							<dd>
								<ul>
									{eps!.toReversed().map((e) => (
										<li>
											<a href={episodeHref(e)}>{e.title}</a>
											{e.kind !== 'regular' && <span class="tag" data-kind={e.kind}>{e.kind}</span>}
										</li>
									))}
								</ul>
							</dd>
						</div>
					))
				}
			</dl>
		</section>
	</div>

	<section class="wrap patreon-latest" aria-labelledby="patreon-h">
		<div class="section-head">
			<h2 id="patreon-h">New on Patreon</h2>
			<a href="/episodes/?type=patreon">All {patreonCount} Patreon exclusives</a>
		</div>
		<p class="muted packs-intro">
			Junk Mail, Retro Reviews, Criterionitis and more, for patrons. <a href={LINKS.patreon}>Join on Patreon</a>
		</p>
		<ul class="rows">
			{patreonLatest.slice(0, 6).map((e) => <EpisodeRow episode={e} />)}
		</ul>
	</section>

	<section class="wrap premiums" aria-labelledby="premium-h">
		<div class="section-head">
			<h2 id="premium-h">Premiums</h2>
			<a href="/commerce/#premiums">All {premiumCount} premiums</a>
		</div>
		<ul>
			{
				premiums.map((p) => (
					<li>
						<a href={episodeHref(p)}>
							<img src={p.art!.replace('_16.jpg', '_2.jpg')} alt="" width="350" height="350" loading="lazy" />
							<span>{p.title}</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>
	<section class="wrap packs" aria-labelledby="packs-h">
		<div class="section-head">
			<h2 id="packs-h">Buy old episodes</h2>
			<a href="/commerce/#packs"><Icon name="gumroad" /> All packs</a>
		</div>
		<p class="muted packs-intro">
			Only the most recent episodes are in the free feed. Every year of the show before that is sold as a pack on Gumroad.
		</p>
		<ul>
			{
				meta.packs.map((p) => (
					<li>
						<PackCard pack={p} />
					</li>
				))
			}
		</ul>
	</section>
</Layout>

<style>
	.hero {
		padding-block: clamp(2rem, 7vw, 5rem) clamp(2rem, 5vw, 3.5rem);
		display: grid;
		grid-template-columns: 1fr minmax(12rem, 20rem);
		gap: 2rem 3rem;
		align-items: center;
	}

	.hero-logo {
		grid-column: 2;
		grid-row: 1;
		width: 100%;
		height: auto;
		border-radius: 1rem;
		transform: rotate(2deg);
	}

	.about {
		grid-column: 1;
		grid-row: 1;
	}

	@media (max-width: 52rem) {
		.hero {
			grid-template-columns: 1fr;
		}
		.hero-logo {
			grid-column: 1;
			width: 9rem;
		}
		.about {
			grid-row: 2;
		}
	}

	.schedule {
		margin-bottom: 3.5rem;
	}

	.schedule ol {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
	}

	.slot {
		display: grid;
		gap: 0.3rem;
		text-decoration: none;
	}

	.slot img,
	.slot .no-poster {
		width: 100%;
		height: auto;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		border-radius: 0.5rem;
		background: var(--line);
		display: block;
	}

	a.slot:hover .what {
		text-decoration: underline;
	}

	.when {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: var(--step-1);
		line-height: 1.1;
		margin-top: 0.2rem;
	}

	.what {
		font-weight: 700;
		line-height: 1.3;
	}

	.status {
		justify-self: start;
		font-size: 0.75rem;
		font-weight: 700;
		padding: 0.1rem 0.5rem;
		border-radius: 999px;
		border: 1px solid var(--line);
		color: var(--muted);
	}

	.slot[data-status='out'] .status {
		border-color: var(--accent);
		color: var(--accent);
	}

	.slot[data-status='patreon'] .status {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--accent-ink);
	}



	h1 {
		font-size: clamp(2.5rem, 6vw, 4.5rem);
		font-weight: 900;
		line-height: 0.95;
		max-width: 20ch;
	}

	.lede {
		font-size: var(--step-1);
		line-height: 1.45;
		max-width: 46ch;
		margin: 1.5rem 0 0;
	}

	.hosts {
		margin-top: 1.5rem;
	}

	.hosts h2 {
		font-size: var(--step-1);
		margin-bottom: 0.5rem;
	}

	.hosts ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 2rem;
	}

	.hosts li {
		display: grid;
		gap: 0.2rem;
	}

	.host-name {
		font-weight: 700;
	}

	.host-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.9rem;
		font-size: var(--step--1);
	}

	.host-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		color: var(--muted);
		text-decoration: none;
	}

	.host-links a:hover {
		color: var(--ink);
		text-decoration: underline;
	}

	.listen {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin: 1.5rem 0 0;
	}

	.big {
		font-size: var(--step-0);
		padding: 0.7rem 1.15rem;
	}


	.split {
		display: grid;
		gap: 3rem;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
		align-items: start;
	}

	@media (max-width: 52rem) {
		.split {
			grid-template-columns: 1fr;
		}
	}

	h2 {
		margin-bottom: 1rem;
	}

	.latest article {
		padding: 1.5rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 0.75rem;
		display: grid;
		gap: 1.25rem;
	}

	.latest article.has-art {
		grid-template-columns: minmax(6rem, 9rem) 1fr;
		align-items: start;
	}

	@media (max-width: 30rem) {
		.latest article.has-art {
			grid-template-columns: 1fr;
		}
		.latest-art {
			max-width: 9rem;
		}
	}

	.latest-art {
		width: 100%;
		height: auto;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		border-radius: 0.4rem;
	}

	.latest-body {
		display: grid;
		gap: 0.75rem;
		justify-items: start;
	}

	.latest h3 {
		font-size: var(--step-3);
	}

	.latest h3 a {
		text-decoration: none;
	}

	.latest p {
		margin: 0;
	}

	.blurb {
		max-width: 62ch;
	}

	.ratings {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
	}

	.ratings span:first-child {
		font-weight: 600;
	}

	.history dl {
		margin: 0;
		max-height: 34rem;
		overflow-y: auto;
		padding-right: 0.5rem;
	}

	.year {
		display: grid;
		grid-template-columns: 4.5rem 1fr;
		gap: 1rem;
		padding-block: 0.6rem;
		border-top: 1px solid var(--line);
	}

	dt {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: var(--step-2);
		line-height: 1;
	}

	dt a {
		text-decoration: none;
	}

	dd {
		margin: 0;
	}

	dd ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.2rem;
	}

	.tag {
		font-size: 0.75rem;
		font-weight: 700;
		margin-left: 0.4rem;
		color: var(--premium);
	}

	.tag[data-kind='patreon'] {
		color: var(--accent);
	}

	.tag[data-kind='bonus'] {
		color: var(--muted);
	}

	.premiums {
		margin-top: 4rem;
	}

	.section-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.premiums ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
	}

	.premiums a {
		display: grid;
		gap: 0.5rem;
		text-decoration: none;
		font-weight: 600;
	}

	.premiums img {
		width: 100%;
		height: auto;
		border-radius: 0.4rem;
		aspect-ratio: 1;
		object-fit: cover;
		background: var(--line);
	}

	.premiums a:hover span {
		text-decoration: underline;
	}

	.packs,
	.patreon-latest {
		margin-top: 4rem;
	}

	.rows {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
		column-gap: 2rem;
	}

	.section-head a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-weight: 600;
		white-space: nowrap;
	}

	.packs-intro {
		margin: -0.25rem 0 1.25rem;
		max-width: 60ch;
	}

	/* One scrolling shelf, like spines on a video store wall. */
	.packs ul {
		list-style: none;
		/* Room for the hover lift and ring, which overflow would otherwise clip. */
		padding: 0.5rem 2px 0.75rem;
		margin: -0.5rem -2px 0;
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: minmax(10.5rem, 12.5rem);
		gap: 1rem;
		overflow-x: auto;
		scroll-snap-type: x proximity;
		scrollbar-width: thin;
		scrollbar-color: var(--line) transparent;
	}

	.packs li {
		scroll-snap-align: start;
	}

</style>

---
import Layout from '../layouts/layout.astro';
import { homeSchema } from '../lib/schema';
import ListenLinks from '../components/listen-links.astro';
import EpisodeRow from '../components/episode-row.astro';
import Stars from '../components/stars.astro';
import Icon from '../components/icon.astro';
import PackCard from '../components/pack-card.astro';
import { episodeArt, episodes, episodeHref, episodeLabel, formatDate, films, hostHref, HOSTS, LINKS, meta, posterUrl } from '../lib/data';

const latest = episodes.find((e) => e.kind === 'regular')!;
const latestArt = episodeArt(latest);
// Premiums picked for the home page, then the newest one to fill the row. Ids are /episodes/<id>/.
const FEATURED_PREMIUMS = [
	'premium-star-wars-the-prequels-bonus-podcast',
	'premium-christopher-nolan',
	'premium-the-halloween-franchise',
	'premium-the-purge-trilogy',
	'premium-marvel-phase-one',
	'premium-paul-thomas-anderson',
];
const allPremiums = episodes.filter((e) => e.kind === 'premium' && e.art);
const featured = FEATURED_PREMIUMS.flatMap((id) => allPremiums.filter((e) => e.id === id));
const premiums = [...featured, ...allPremiums.filter((e) => !featured.includes(e))].slice(0, 6);

// This month's schedule, or the latest one posted.
const thisMonth = new Date().toISOString().slice(0, 7);
const schedule = meta.schedule.find((m) => m.month === thisMonth) ?? meta.schedule[0];
const scheduleName = schedule && new Date(schedule.month + '-01T00:00:00Z').toLocaleString('en-US', { month: 'long', timeZone: 'UTC' });
// October is Junktober on the show.
const scheduleHeading = scheduleName === 'October' ? 'Junktober Lineup' : `${scheduleName} Lineup`;
// "Mon, Oct 5"; the weekday is dropped on phones, where the lineup's columns are narrow.
const weekdayFormat = new Intl.DateTimeFormat('en-US', { weekday: 'short', timeZone: 'UTC' });
const dayFormat = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const weekday = (iso: string) => weekdayFormat.format(new Date(iso + 'T00:00:00Z'));
const day = (iso: string) => dayFormat.format(new Date(iso + 'T00:00:00Z'));

// "This month in history" is fixed at build time; the site rebuilds daily.
const now = new Date();
const month = String(now.getUTCMonth() + 1).padStart(2, '0');
const monthName = now.toLocaleString('en-US', { month: 'long', timeZone: 'UTC' });
const thisYear = String(now.getUTCFullYear());
const history = Object.entries(
	Object.groupBy(
		episodes.filter((e) => e.date.slice(5, 7) === month && e.date.slice(0, 4) !== thisYear && !e.dateApprox),
		(e) => e.date.slice(0, 4)
	)
).sort(([a], [b]) => b.localeCompare(a));

const patreonLatest = episodes.filter((e) => e.kind === 'patreon');
const blurb = latest.description.length > 420 ? latest.description.slice(0, 420).replace(/\s\S*$/, '') + '…' : latest.description;
---

<Layout
	title="The Longest Running Movie Podcast"
	description={`Movie reviews, TV talk and film news since 2005. Search ${films.length.toLocaleString()} films across every Film Junk Podcast episode, premium and Patreon exclusive.`}
	schema={homeSchema(Astro.site)}
>
	<section class="hero-band">
		<!-- One pre-rendered image of the show's most-discussed films (scripts/build-hero.ts). -->
		<picture class="wall" aria-hidden="true">
			<source media="(max-width: 40rem)" srcset="/hero-wall-small.webp" />
			<img src="/hero-wall.webp" alt="" width="2400" height="764" fetchpriority="high" />
		</picture>
		<div class="hero wrap">
		<div class="about">
			<h1>The Longest Running <span class="line">Movie Podcast</span></h1>
			<p class="lede muted">An unofficial companion to the Film Junk Podcast, {latest.number!.toLocaleString()} episodes and counting.</p>
			<div class="hosts">
				<h2 class="label">Hosted by</h2>
				<ul>
					{
						HOSTS.map((h) => (
							<li>
								<a class="host-name" href={`/hosts/${h.slug}/`}>{h.name}</a>
								<span class="host-links">
									{h.links.map((l) => (
										<a href={l.url} title={`${h.name.split(' ')[0]}'s ${l.label}`} aria-label={`${h.name.split(' ')[0]}'s ${l.label}`}>
											<Icon name={l.icon} />
										</a>
									))}
								</span>
							</li>
						))
					}
				</ul>
			</div>
			<p class="listen">
				<a class="button big patreon" href={LINKS.patreon}><Icon name="patreon" /> Support on Patreon</a>
				<a class="button big spotify" href={LINKS.spotify}><Icon name="spotify" /> Spotify</a>
				<a class="button big" href={LINKS.apple}><Icon name="apple" /> Apple Podcasts</a>
			</p>
		</div>
		</div>
	</section>

	<section class="wrap latest" aria-labelledby="latest-h">
		<div class="section-head">
			<h2 id="latest-h">Latest episode</h2>
			<a href="/episodes/">More episodes</a>
		</div>
		<article class:list={[{ 'has-art': latestArt }]}>
			{latestArt && <img class="latest-art" src={latestArt.src} alt="" width="500" height="750" />}
			<div class="latest-body">
			<p class="label muted">{episodeLabel(latest)} · <time datetime={latest.date}>{formatDate(latest.date)}</time></p>
			<h3><a href={episodeHref(latest)}>{latest.title}</a></h3>
			{blurb && <p class="blurb">{blurb}</p>}
			{
				latest.reviews?.some((r) => r.ratings.length) && (
					<ul class="ratings">
						{latest.reviews.flatMap((r) =>
							r.ratings.map((x) => (
								<li>
									<span>{hostHref(x.host) ? <a href={hostHref(x.host)}>{x.host}</a> : x.host}</span> <Stars score={x.score} outOf={x.outOf} />
								</li>
							))
						)}
					</ul>
				)
			}
			<ListenLinks episode={latest} />
			</div>
		</article>
	</section>

	<div class="wrap split">
		{
			schedule && (
				<section class="schedule" aria-labelledby="schedule-h">
					<div class="section-head">
						<h2 id="schedule-h">
							{scheduleName === 'October' && <span aria-hidden="true">🎃 </span>}
							{scheduleHeading}
						</h2>
						{schedule.source && (
							<a href={schedule.source}>
								<Icon name="instagram" /> Calendar
							</a>
						)}
					</div>
					{schedule.note && <p class="muted packs-intro">{schedule.note}</p>}
					<ol>
						{schedule.items.map((item) => {
							const href = item.episode ? `/episodes/${item.episode}/` : item.film ? `/films/${item.film}/` : null;
							const Tag = href ? 'a' : 'div';
							return (
								<li>
									<Tag class="slot" href={href ?? undefined} data-status={item.status}>
										{item.poster ? (
											<img src={posterUrl(item.poster, 'w342')} alt="" width="342" height="513" loading="lazy" />
										) : (
											<span class="no-poster" aria-hidden="true" />
										)}
										<span class="when">
											<span class="weekday">{weekday(item.date)}, </span>
											{day(item.date)}
										</span>
										<span class="what">
											{item.title}
											{item.year && <span class="muted"> ({item.year})</span>}
										</span>
										<span class="status">
											{item.status === 'out' ? 'Out now' : item.status === 'patreon' ? 'On Patreon now' : 'Coming up'}
										</span>
									</Tag>
								</li>
							);
						})}
					</ol>
				</section>
			)
		}

		<section class="history" aria-labelledby="history-h">
			<h2 id="history-h">{monthName} in Film Junk history</h2>
			<dl>
				{
					history.map(([year, eps]) => (
						<div class="year">
							<dt>
								<a href={`/years/${year}/`}>{year}</a>
							</dt>
							<dd>
								<ul>
									{eps!.toReversed().map((e) => (
										<li>
											<a href={episodeHref(e)}>{e.title}</a>
											{e.kind !== 'regular' && <span class="tag" data-kind={e.kind}>{e.kind}</span>}
										</li>
									))}
								</ul>
							</dd>
						</div>
					))
				}
			</dl>
		</section>
	</div>

	<section class="wrap patreon-latest" aria-labelledby="patreon-h">
		<div class="section-head">
			<h2 id="patreon-h">New on Patreon</h2>
			<a href="/episodes/?type=patreon">More Patreon</a>
		</div>
		<p class="muted packs-intro">
			Junk Mail, Retro Reviews, Criterionitis and more, for patrons. <a href={LINKS.patreon}>Join on Patreon</a>
		</p>
		<ul class="rows">
			{patreonLatest.slice(0, 6).map((e) => <EpisodeRow episode={e} hideKind />)}
		</ul>
	</section>

	<section class="wrap premiums" aria-labelledby="premium-h">
		<div class="section-head">
			<h2 id="premium-h">Premiums</h2>
			<a href="/commerce/#premiums">More premiums</a>
		</div>
		<ul>
			{
				premiums.map((p) => (
					<li>
						<a href={episodeHref(p)}>
							<img src={p.art!.replace('_16.jpg', '_2.jpg')} alt="" width="350" height="350" loading="lazy" />
							<span>{p.title}</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>
	<section class="wrap packs" aria-labelledby="packs-h">
		<div class="section-head">
			<h2 id="packs-h">Archive</h2>
			<a href="/commerce/#packs"><Icon name="gumroad" /> All packs</a>
		</div>
		<p class="muted packs-intro">
			Only the most recent episodes are in the free feed. Every year of the show before that is sold as a pack on Gumroad.
		</p>
		<ul>
			{
				meta.packs.map((p) => (
					<li>
						<PackCard pack={p} />
					</li>
				))
			}
		</ul>
	</section>
	{
		meta.universe.length > 0 && (
			<section class="wrap universe" aria-labelledby="universe-h">
				<h2 id="universe-h">Junk Universe</h2>
				<p class="muted packs-intro">The other Film Junk shows, about games, sports and TV.</p>
				<ul>
					{meta.universe.map((show) => (
						<li>
							<div class="show">
								<img src={show.art} alt="" width="600" height="600" loading="lazy" />
								<h3>{show.name}</h3>
								<span class="apps">
									<a href={show.spotify} aria-label={`${show.name} on Spotify`} title="Spotify">
										<Icon name="spotify" />
									</a>
									<a href={show.url} aria-label={`${show.name} on Apple Podcasts`} title="Apple Podcasts">
										<Icon name="apple" />
									</a>
								</span>
							</div>
							<ol>
								{show.episodes.map((ep) => (
									<li>
										<span class="label muted">
											{ep.number && <>Ep. {ep.number} · </>}
											{formatDate(ep.date)}
										</span>
										<a href={ep.url}>{ep.title}</a>
									</li>
								))}
							</ol>
						</li>
					))}
				</ul>
			</section>
		)
	}
</Layout>

<style>
	/* A tilted wall of posters behind the whole hero. */
	.hero-band {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		margin-bottom: 1rem;
	}

	.wall {
		position: absolute;
		inset: 0;
		z-index: -2;
		opacity: 0.6;
	}

	.wall img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.hero-band::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		/* The whole wall dimmed, a little more behind the text, and faded out at the top and bottom. */
		background:
			linear-gradient(180deg, var(--bg) 0%, transparent 18%),
			linear-gradient(0deg, var(--bg) 0%, transparent 35%),
			linear-gradient(90deg, color-mix(in srgb, var(--bg) 75%, transparent) 20%, transparent 65%),
			color-mix(in srgb, var(--bg) 60%, transparent);
	}

	.hero {
		padding-block: clamp(3rem, 9vw, 6.5rem) clamp(2.5rem, 6vw, 4.5rem);
	}

	.about {
		max-width: 40rem;
	}

	/* Phones: the text runs full width, so the wall is dimmed a little more. */
	@media (max-width: 40rem) {
		.hero-band::after {
			background:
				linear-gradient(180deg, var(--bg) 0%, transparent 15%),
				linear-gradient(0deg, var(--bg) 0%, transparent 40%),
				color-mix(in srgb, var(--bg) 78%, transparent);
		}

	}


	.latest {
		margin-bottom: 3.5rem;
	}

	.schedule ol {
		list-style: none;
		padding: 0;
		margin: 0;
		/* The whole month in one row, however many episodes it has. */
		display: grid;
		gap: 1rem;
		grid-auto-flow: column;
		grid-auto-columns: minmax(0, 1fr);
	}

	@media (max-width: 40rem) {
		.schedule ol {
			gap: 0.6rem;
		}

		.weekday {
			display: none;
		}
	}

	.slot {
		display: grid;
		gap: 0.3rem;
		text-decoration: none;
	}

	.slot img,
	.slot .no-poster {
		width: 100%;
		height: auto;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		border-radius: var(--radius);
		background: var(--line);
		display: block;
	}

	a.slot:hover .what {
		text-decoration: underline;
	}

	.when {
		font-size: var(--step--2);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
		margin-top: 0.35rem;
	}

	.what {
		font-size: var(--step--1);
		font-weight: 700;
		line-height: 1.3;
		color: var(--ink);
	}

	.status {
		justify-self: start;
		font-size: 0.75rem;
		font-weight: 700;
		padding: 0.1rem 0.5rem;
		border-radius: 999px;
		border: 1px solid var(--line);
		color: var(--muted);
	}

	.slot[data-status='out'] .status {
		border-color: var(--accent);
		color: var(--accent);
	}

	.slot[data-status='patreon'] .status {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--accent-ink);
	}



	/* "Movie Podcast" always gets a line of its own, so the title breaks the same way at every width. */
	h1 .line {
		display: block;
	}

	h1 {
		font-size: clamp(2.25rem, 5vw, 3.5rem);
		line-height: 1.05;
	}

	.lede {
		font-size: var(--step-1);
		line-height: 1.45;
		max-width: 46ch;
		margin: 1.5rem 0 0;
	}

	.hosts {
		margin-top: 1.5rem;
	}

	.hosts h2 {
		color: var(--muted);
		margin-bottom: 0.5rem;
	}

	.hosts ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.75rem;
	}

	/* Name, then each link as an icon; the tooltip and label name it. */
	.hosts li {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.host-name {
		font-weight: 700;
		color: var(--ink);
	}

	.host-links {
		display: flex;
		gap: 0.15rem;
	}

	.host-links a {
		display: inline-grid;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		color: var(--muted);
	}

	.host-links a:hover {
		color: var(--ink);
	}

	.listen {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin: 1.5rem 0 0;
	}

	.big {
		font-size: var(--step-0);
		padding: 0.7rem 1.15rem;
	}

	/* Phones: Patreon across the top, the listening apps in a row underneath. */
	@media (max-width: 30rem) {
		.listen {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 0.5rem;
		}

		.listen .patreon {
			grid-column: 1 / -1;
		}

		.big {
			justify-content: center;
			padding-inline: 0.5rem;
		}
	}


	.split {
		display: grid;
		gap: 3rem;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
		align-items: start;
	}

	@media (max-width: 52rem) {
		.split {
			grid-template-columns: 1fr;
		}
	}

	h2 {
		margin-bottom: 1rem;
	}

	.latest article {
		padding: 1.5rem 0;
		border-top: 1px solid var(--line);
		display: grid;
		gap: 1.25rem;
	}

	.latest article.has-art {
		grid-template-columns: minmax(6rem, 9rem) 1fr;
		align-items: start;
	}

	@media (max-width: 30rem) {
		.latest article.has-art {
			grid-template-columns: 1fr;
		}
		.latest-art {
			max-width: 9rem;
		}
	}

	.latest-art {
		width: 100%;
		height: auto;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		border-radius: var(--radius);
	}

	.latest-body {
		display: grid;
		gap: 0.75rem;
		justify-items: start;
	}

	.latest h3 {
		font-size: var(--step-3);
	}

	.latest h3 a {
		text-decoration: none;
	}

	.latest p {
		margin: 0;
	}

	.blurb {
		max-width: 62ch;
	}

	.ratings {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
	}

	.ratings span:first-child {
		font-weight: 600;
	}

	.history dl {
		margin: 0;
		max-height: 34rem;
		overflow-y: auto;
		padding-right: 0.5rem;
	}

	.year {
		display: grid;
		grid-template-columns: 4.5rem 1fr;
		gap: 1rem;
		padding-block: 0.6rem;
		border-top: 1px solid var(--line);
	}

	dt {
		font-size: var(--step--1);
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.6;
		font-variant-numeric: tabular-nums;
	}

	dt a {
		text-decoration: none;
	}

	dd {
		margin: 0;
	}

	dd ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.2rem;
	}

	.tag {
		font-size: 0.75rem;
		font-weight: 700;
		margin-left: 0.4rem;
		color: var(--premium);
	}

	.tag[data-kind='patreon'] {
		color: var(--accent);
	}

	.tag[data-kind='bonus'] {
		color: var(--muted);
	}

	.premiums {
		margin-top: 4rem;
	}

	.section-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.premiums ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 1rem;
		grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
	}

	.premiums a {
		display: grid;
		gap: 0.5rem;
		text-decoration: none;
		font-weight: 600;
	}

	.premiums img {
		width: 100%;
		height: auto;
		border-radius: var(--radius);
		aspect-ratio: 1;
		object-fit: cover;
		background: var(--line);
	}

	.premiums a:hover span {
		text-decoration: underline;
	}

	.packs,
	.universe,
	.patreon-latest {
		margin-top: 4rem;
	}

	.universe > ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: 2rem;
	}

	.show {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--line);
	}

	.show h3 {
		flex: 1;
		font-size: var(--step-1);
	}

	/* Spotify or Apple: icon buttons, so listeners pick their app. */
	.apps {
		display: flex;
		gap: 0.35rem;
	}

	.apps a {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--muted);
	}

	.apps a:hover {
		border-color: var(--ink);
		color: var(--ink);
	}

	.show img {
		width: 3.5rem;
		height: 3.5rem;
		border-radius: var(--radius);
	}

	.universe ol {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.universe ol li {
		display: grid;
		gap: 0.15rem;
		padding-block: 0.6rem;
		border-bottom: 1px solid var(--line);
	}

	.universe ol a {
		color: var(--ink);
		font-weight: 600;
		line-height: 1.35;
	}

	.rows {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
		column-gap: 2rem;
	}

	.section-head a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-weight: 600;
		white-space: nowrap;
	}

	.packs-intro {
		margin: -0.25rem 0 1.25rem;

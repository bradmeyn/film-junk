---
import Layout from '../../layouts/layout.astro';
import Icon from '../../components/icon.astro';
import { episodes, episodeHref, formatDate, LINKS } from '../../lib/data';

const premiums = episodes.filter((e) => e.kind === 'premium');
---

<Layout title="Premium episodes" description="Every Film Junk premium podcast: franchise and filmmaker deep dives.">
	<div class="wrap">
		<h1>Premiums</h1>
		<div class="intro">
			<p>
				Since 2011 the guys have made {premiums.length} premium episodes, most of them deep dives into a franchise or a filmmaker. Patreon
				supporters get all of them. You can also buy them one at a time on Bandcamp.
			</p>
			<p class="actions">
				<a class="button patreon" href={LINKS.patreon}><Icon name="patreon" /> Get them all on Patreon</a>
				<a class="button" href={LINKS.bandcamp}><Icon name="bandcamp" /> Browse Bandcamp</a>
			</p>
		</div>

		<ul class="grid">
			{
				premiums.map((p) => (
					<li>
						<a href={episodeHref(p)}>
							{p.art ? (
								<img src={p.art.replace('_16.jpg', '_2.jpg')} alt="" width="350" height="350" loading="lazy" />
							) : (
								<span class="placeholder" aria-hidden="true">
									{p.number ? `#${p.number}` : 'FJ'}
								</span>
							)}
							<span class="t">{p.title}</span>
							<span class="muted d">{formatDate(p.date)}</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</Layout>

<style>
	h1 {
		font-size: var(--step-4);
		margin-top: 1.5rem;
	}

	.intro {
		max-width: 60ch;
		margin-bottom: 2.5rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 1.5rem 1rem;
		grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
	}

	.grid a {
		display: grid;
		gap: 0.35rem;
		text-decoration: none;
	}

	.grid a:hover .t {
		text-decoration: underline;
	}

	img,
	.placeholder {
		width: 100%;
		height: auto;
		aspect-ratio: 1;
		border-radius: 0.4rem;
		object-fit: cover;
		background: var(--line);
	}

	.placeholder {
		display: grid;
		place-items: center;
		background: var(--slime);
		color: var(--slime-ink);
		font-family: var(--font-display);
		font-weight: 900;
		font-size: var(--step-3);
	}

	.t {
		font-weight: 700;
		line-height: 1.3;
	}

	.d {
		font-size: var(--step--1);
	}
</style>

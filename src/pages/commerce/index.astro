---
import Layout from '../../layouts/layout.astro';
import Icon from '../../components/icon.astro';
import PackCard from '../../components/pack-card.astro';
import { episodes, episodeHref, formatDate, LINKS, meta } from '../../lib/data';

const premiums = episodes.filter((e) => e.kind === 'premium');
---

<Layout
	title="Commerce: premiums and old episodes"
	description={`Where to get more Film Junk: ${premiums.length} premium episodes on Patreon and Bandcamp, and every past year of the podcast as a Gumroad pack.`}
>
	<div class="wrap">
		<h1>Commerce</h1>
		<p class="lede">More Film Junk than the free feed: the premium deep dives, and every past year of the show.</p>
		<nav class="jump" aria-label="On this page">
			<a href="#premiums">Premiums</a>
			<a href="#packs">Old episodes</a>
		</nav>

		<section id="premiums" aria-labelledby="premiums-h">
			<h2 id="premiums-h">Premiums</h2>
			<div class="intro">
				<p>
					Since 2011 the guys have made {premiums.length} premium episodes, most of them deep dives into a franchise or a filmmaker. New
					premiums come out on Patreon, and the back catalogue is sold one at a time on Bandcamp.
				</p>
				<p class="actions">
					<a class="button patreon" href={LINKS.patreon}><Icon name="patreon" /> Patreon</a>
					<a class="button" href={LINKS.bandcamp}><Icon name="bandcamp" /> Bandcamp</a>
				</p>
			</div>

		<ul class="grid">
			{
				premiums.map((p) => (
					<li>
						<a href={episodeHref(p)}>
							{p.art ? (
								<img src={p.art.replace('_16.jpg', '_2.jpg')} alt="" width="350" height="350" loading="lazy" />
							) : (
								<span class="placeholder" aria-hidden="true">
									{p.number ? `#${p.number}` : 'FJ'}
								</span>
							)}
							<span class="t">{p.title}</span>
							<span class="muted d">{formatDate(p.date)}</span>
						</a>
					</li>
				))
			}
		</ul>
		</section>

		<section id="packs" aria-labelledby="packs-h">
			<h2 id="packs-h">Old episodes</h2>
			<div class="intro">
				<p>
					Only the most recent weekly shows are in the free feed. Every year before that is sold as a pack on Gumroad, along with
					Space Junk and the bonus shows.
				</p>
				<p class="actions">
					<a class="button" href={LINKS.gumroad}><Icon name="gumroad" /> Gumroad</a>
				</p>
			</div>
			<ul class="packs">
				{
					meta.packs.map((p) => (
						<li>
							<PackCard pack={p} />
						</li>
					))
				}
			</ul>
		</section>
	</div>
</Layout>

<style>
	h1 {
		font-size: var(--step-4);
		margin: 1.5rem 0 0.25rem;
	}

	.lede {
		margin: 0 0 1rem;
		max-width: 60ch;
		color: var(--muted);
	}

	.jump {
		display: flex;
		gap: 1.25rem;
		font-weight: 600;
		margin-bottom: 2.5rem;
	}

	section {
		scroll-margin-top: 1rem;
	}

	section + section {
		margin-top: 4rem;
	}

	h2 {
		font-size: var(--step-3);
		margin: 0 0 0.5rem;
	}

	.packs {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 1.5rem 1rem;
		grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
	}

	.intro {
		max-width: 60ch;
		margin-bottom: 2.5rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 1.5rem 1rem;
		grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
	}

	.grid a {
		display: grid;
		gap: 0.35rem;
		text-decoration: none;
	}

	.grid a:hover .t {
		text-decoration: underline;
	}

	img,
	.placeholder {
		width: 100%;
		height: auto;
		aspect-ratio: 1;
		border-radius: 0.4rem;
		object-fit: cover;
		background: var(--line);
	}

	.placeholder {
		display: grid;
		place-items: center;
		background: var(--slime);
		color: var(--slime-ink);
		font-family: var(--font-display);
		font-weight: 900;
		font-size: var(--step-3);
	}

	.t {
		font-weight: 700;
		line-height: 1.3;
	}

	.d {
		font-size: var(--step--1);
	}
</style>

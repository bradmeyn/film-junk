---
import Layout from '../../layouts/layout.astro';
import EpisodeBrowser, { type Item } from '../../components/episode-browser.svelte';
import { averageRating, episodes, leadPoster, meta, posterUrl, years } from '../../lib/data';

// Year-end shows: the hosts' top 10 lists and the Junkies awards.
const yearEnd = new Set(Object.values(meta.yearEnd).flatMap((shows) => shows.map((s) => s.id)));

const items: Item[] = episodes.map((e) => ({
	id: e.id,
	n: e.number,
	k: e.kind,
	d: e.date,
	t: e.title,
	h: [...new Set((e.reviews ?? []).flatMap((r) => r.ratings.map((x) => x.host)))],
	a: averageRating(e.reviews),
	...(yearEnd.has(e.id) && { y: true }),
	// Artwork: the episode's lead film poster, else a premium's Bandcamp cover (the 350px size).
	p: posterUrl(leadPoster(e), 'w154') ?? e.art?.replace('_16.jpg', '_2.jpg'),
	// Each film's ratings; the title only when the episode reviews more than one.
	r: (e.reviews ?? [])
		.filter((r) => r.ratings.length)
		.map((r, _, all) => ({
			...(all.length > 1 && { t: r.title }),
			s: r.ratings.map((x) => [x.host, x.score, x.outOf] as [string, number, number]),
		})),
}));

// Regular hosts first, then guests by how often they rated something.
const hostCounts = new Map<string, number>();
for (const i of items) for (const h of i.h) hostCounts.set(h, (hostCounts.get(h) ?? 0) + 1);
const hosts = [...hostCounts].filter(([, n]) => n >= 5).sort((a, b) => b[1] - a[1]).map(([h]) => h);
---

<Layout title="Episodes" description="Every Film Junk Podcast episode since 2005, with the movies reviewed and each host's rating. Filter by year, type and host, or find the year-end top 10s and Junkies.">
	<div class="wrap">
		<div class="head">
			<h1>Episodes</h1>
			<p class="muted intro">
				Every episode since 2005, with the films reviewed and each host's rating.
			</p>
		</div>
		<h2 class="visually-hidden">All episodes</h2>
		<EpisodeBrowser client:load {items} {years} {hosts} />
	</div>
</Layout>

<style>
	.head {
		margin: 1.5rem 0 1.25rem;
	}

	h1 {
		font-size: var(--step-4);
	}

	.intro {
		max-width: 55ch;
		margin: 0.5rem 0 0;
	}
</style>

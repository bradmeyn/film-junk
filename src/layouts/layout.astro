---
import '@fontsource-variable/big-shoulders-display';
import '@fontsource-variable/public-sans';
import '@fontsource-variable/public-sans/wght-italic.css';
import '../styles/global.css';
import displayFont from '@fontsource-variable/big-shoulders-display/files/big-shoulders-display-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/public-sans/files/public-sans-latin-wght-normal.woff2?url';
import Icon from '../components/icon.astro';
import FilmSearch from '../components/film-search.svelte';
import { LINKS } from '../lib/data';

interface Props {
	title?: string;
	description?: string;
	image?: string | null; // share preview image
	type?: 'website' | 'article' | 'video.movie' | 'profile';
	schema?: Record<string, unknown> | Record<string, unknown>[]; // schema.org JSON-LD
	noindex?: boolean;
}

const DEFAULT_IMAGE = 'https://assets.libsyn.com/images/filmjunk/FJ_PodcastArt_3000.jpg';
const {
	title,
	description = 'Every Film Junk Podcast episode, premium and bonus show, searchable by the films they reviewed or talked about.',
	image,
	type = 'website',
	schema,
	noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} | Film Junk Podcast` : 'Film Junk Podcast';
const path = Astro.url.pathname;
// Absolute URLs need the site address (SITE_URL); without it they're left out rather than guessed.
const canonical = Astro.site ? new URL(path, Astro.site).href : null;
const shareImage = image ?? DEFAULT_IMAGE;
// JSON-LD sits in a <script>, so escape "<" to keep a title like "</script>" from ending it.
const jsonLd = schema && JSON.stringify(schema).replace(/</g, '\\u003c');
const nav = [
	['/episodes/', 'Episodes'],
	['/films/', 'Films'],
	['/junkies/', 'Junkies'],
	['/commerce/', 'Commerce'],
];
// Everywhere else to find the show, from Film Junk's Linktree (linktr.ee/filmjunk).
const footerGroups = [
	{
		title: 'This site',
		links: [
			['/episodes/', 'Every episode'],
			['/films/', 'Every film'],
			['/junkies/', 'The Junkies'],
			['/commerce/', 'Premiums and old episodes'],
			['/random/', 'Surprise me'],
		],
	},
	{
		title: 'Listen',
		links: [
			[LINKS.spotify, 'Spotify'],
			[LINKS.apple, 'Apple Podcasts'],
			['https://www.youtube.com/c/filmjunkpodcast', 'YouTube'],
			[LINKS.rss, 'RSS feed'],
		],
	},
	{
		title: 'Support',
		links: [
			[LINKS.patreon, 'Patreon'],
			[LINKS.bandcamp, 'Premiums on Bandcamp'],
			[LINKS.gumroad, 'Back episodes on Gumroad'],
		],
	},
	{
		title: 'Community',
		links: [
			['https://reddit.com/r/filmjunk', 'r/filmjunk'],
			['https://discord.gg/HBKVk6z', 'Discord'],
			['https://linktr.ee/gamejunk', 'Game Junk Podcast'],
			['https://open.spotify.com/show/1oeuu9Naaubbag6HgbDtTH', 'Ball Junk Podcast'],
			['mailto:filmjunk@gmail.com', 'filmjunk@gmail.com'],
		],
	},
] as const;
const social = [
	['instagram', 'Instagram', 'https://instagram.com/filmjunkpodcast'],
	['bluesky', 'Bluesky', 'https://bsky.app/profile/filmjunk.bsky.social'],
	['tiktok', 'TikTok', 'https://tiktok.com/@filmjunkpodcast'],
	['threads', 'Threads', 'https://www.threads.com/@filmjunkpodcast'],
	['x', 'X', 'https://x.com/filmjunk'],
	['facebook', 'Facebook', 'https://facebook.com/filmjunk'],
	['twitch', 'Twitch', 'https://www.twitch.tv/filmjunkpodcast'],
] as const;

// Year pages live under Episodes.
const current = (href: string) => path.startsWith(href) || (href === '/episodes/' && path.startsWith('/years/'));
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		{canonical && <link rel="canonical" href={canonical} />}
		{Astro.site && <link rel="sitemap" href="/sitemap-index.xml" />}
		<link rel="alternate" type="application/rss+xml" title="Film Junk Podcast" href={LINKS.rss} />
		<meta name="theme-color" content="#eef0f4" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#11142a" media="(prefers-color-scheme: dark)" />
		<meta property="og:site_name" content="Film Junk Podcast" />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={title ?? 'Film Junk Podcast'} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={shareImage} />
		{canonical && <meta property="og:url" content={canonical} />}
		<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={shareImage} />
		{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
		<!-- Posters come from TMDB, so open that connection early. -->
		<link rel="preconnect" href="https://image.tmdb.org" />
		<!-- Fonts are self-hosted (Fontsource) so text paints without waiting on another domain. -->
		<link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
	</head>
	<body>
		<header class="site-header wrap">
			<a class="brand" href="/">
				<img src="/logo-128.jpg" alt="" width="40" height="40" />
				<span>Film Junk <span class="guide">Podcast</span></span>
			</a>
			<div class="header-search">
				<FilmSearch client:load compact id="site-search" />
			</div>
			<nav aria-label="Main">
				{
					nav.map(([href, label]) => (
						<a href={href} aria-current={current(href) ? 'page' : undefined}>
							{label}
						</a>
					))
				}
			</nav>
			<div class="header-links">
				<a class="pill patreon" href={LINKS.patreon} aria-label="Patreon" title="Patreon"><Icon name="patreon" /><span>Patreon</span></a>
				<a class="pill" href={LINKS.spotify} aria-label="Spotify" title="Spotify"><Icon name="spotify" /><span>Spotify</span></a>
				<a class="pill" href={LINKS.apple} aria-label="Apple Podcasts" title="Apple Podcasts"><Icon name="apple" /><span>Apple</span></a>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="wrap">
				<div class="footer-groups">
					{
						footerGroups.map((g) => (
							<section>
								<h2>{g.title}</h2>
								<ul>
									{g.links.map(([href, label]) => (
										<li>
											<a href={href}>{label}</a>
										</li>
									))}
								</ul>
							</section>
						))
					}
				</div>
				<ul class="social" aria-label="Film Junk on social media">
					{
						social.map(([icon, label, href]) => (
							<li>
								<a href={href} aria-label={label} title={label}>
									<Icon name={icon} size="1.15em" />
								</a>
							</li>
						))
					}
				</ul>
				<p class="muted credits">
					An unofficial fan guide, not affiliated with Film Junk. Episode details come from the show's{' '}
					<a href="https://filmjunk.libsyn.com/">official episode guides</a>, and notes from the{' '}
					<a href="https://filmjunk.fandom.com/wiki/FilmJunk_Wikia">Film Junk fan wiki</a>{' '}
					(<a href="https://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA</a>). Film posters and details from{' '}
					<a href="https://www.themoviedb.org/">TMDB</a>. This product uses the TMDB API but is not endorsed or certified by TMDB.
				</p>
			</div>
		</footer>
	</body>
</html>

<style>
	.site-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.5rem;
		padding-block: 1.25rem;
	}

	.brand {
		color: var(--ink);
		font-family: var(--font-display);
		font-weight: 900;
		font-size: 1.75rem;
		text-decoration: none;
		line-height: 1;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
	}

	.brand img {
		border-radius: 0.4rem;
	}

	.brand .guide {
		color: var(--accent);
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		font-weight: 600;
		color: var(--ink);
	}

	.header-search {
		flex: 1 1 14rem;
		max-width: 26rem;
	}

	.site-header nav {
		margin-left: auto;
	}

	/* Logo-only in the header; the home page has the labelled versions. */
	.pill span {
		display: none;
	}

	/* Narrow: brand and listen buttons, then search, then nav. */
	@media (max-width: 70rem) {
		.site-header {
			padding-block: 1rem 0.5rem;
		}
		.header-links {
			margin-left: auto;
		}
		.header-search {
			order: 3;
			flex-basis: 100%;
			max-width: none;
		}
		.site-header nav {
			order: 4;
			margin-left: 0;
		}
	}

	/* Phones: keep the brand and listen icons on one row, and the nav on one scrollable row. */
	@media (max-width: 30rem) {
		.site-header {
			column-gap: 0.75rem;
		}
		.brand {
			font-size: var(--step-1);
		}
		.brand img {
			width: 32px;
			height: 32px;
		}
		.site-header nav {
			flex-wrap: nowrap;
			gap: 0.75rem;
			font-size: 0.875rem;
			overflow-x: auto;
			scrollbar-width: none;
			max-width: 100%;
		}
		nav a {
			white-space: nowrap;
		}
	}

	.header-links {
		display: flex;
		gap: 0.5rem;
	}

	.pill {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.45rem;
		border-radius: 999px;
		border: 1px solid var(--line);
		font-weight: 700;
		font-size: var(--step--1);
		text-decoration: none;
	}

	.pill:hover {
		border-color: var(--ink);
	}

	.pill.patreon {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--accent-ink);
	}

	nav a {
		text-decoration: none;
		padding-block: 0.25rem;
		border-bottom: 2px solid transparent;
	}

	nav a:hover,
	nav a[aria-current='page'] {
		border-bottom-color: var(--accent);
	}

	main {
		min-height: 60vh;
		padding-bottom: 4rem;
	}

	.site-footer {
		border-top: 1px solid var(--line);
		padding-block: 2rem 3rem;
		font-size: var(--step--1);
	}

	.footer-groups {
		display: grid;
		gap: 1.5rem 2rem;
		grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
	}

	.site-footer h2 {
		font-family: var(--font-body);
		font-size: var(--step--1);
		font-weight: 700;
		letter-spacing: 0;
		margin-bottom: 0.5rem;
	}

	.site-footer ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.footer-groups li + li {
		margin-top: 0.3rem;
	}

	.social {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		margin-top: 1.75rem !important;
	}

	.social a {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 50%;
		color: var(--muted);
	}

	.social a:hover {
		color: var(--ink);
		background: var(--surface);
	}

	.credits {
		margin: 1.25rem 0 0;
		max-width: 70ch;
	}
</style>

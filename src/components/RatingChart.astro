---
// Histogram of one host's ratings, bucketed to half stars on a 5-star scale.
// Single series: one color, no legend (the heading names it), hover/focus tooltip per bar,
// and a table view for screen readers and anyone who wants the numbers.
interface Props {
	scores: number[]; // already normalised to 5; bonus "6 out of 5" scores are > 5
	host: string;
}
const { scores, host } = Astro.props;

const buckets = Array.from({ length: 11 }, (_, i) => ({ label: `${i / 2}`, value: i / 2, count: 0 }));
const bonus = { label: '5+', value: 6, count: 0 };
for (const s of scores) {
	if (s > 5) bonus.count++;
	else buckets[Math.round(s * 2)].count++;
}
// Drop empty low buckets so the chart starts where the ratings do.
const firstUsed = buckets.findIndex((b) => b.count > 0);
const bars = [...buckets.slice(Math.max(0, firstUsed)), ...(bonus.count ? [bonus] : [])];
const max = Math.max(...bars.map((b) => b.count));
const total = scores.length;
const peak = bars.find((b) => b.count === max)!;
const name = (b: { label: string }) => (b.label === '5+' ? '6 out of 5' : `${b.label} stars`);
const pct = (n: number) => `${Math.round((n / total) * 100)}%`;
---

<figure class="chart">
	<div class="plot" role="img" aria-label={`${host}'s ratings: most often ${name(peak)} (${peak.count} of ${total}).`}>
		{
			bars.map((b) => (
				<div class="col">
					<div class="bar-area">
						{b === peak && <span class="direct">{b.count}</span>}
						<button
							type="button"
							class="bar"
							style={`height: ${Math.max((b.count / max) * 100, b.count ? 1.5 : 0)}%`}
							aria-label={`${name(b)}: ${b.count} films, ${pct(b.count)}`}
						>
							<span class="tip" role="tooltip">
								<strong>{name(b)}</strong>
								{b.count} films, {pct(b.count)}
							</span>
						</button>
					</div>
					<span class="tick">{b.label}</span>
				</div>
			))
		}
	</div>
	<figcaption class="muted">Stars given. Older 4-star ratings are scaled to 5.</figcaption>
	<details>
		<summary>Show as a table</summary>
		<table>
			<thead>
				<tr><th scope="col">Rating</th><th scope="col">Films</th><th scope="col">Share</th></tr>
			</thead>
			<tbody>
				{
					bars.map((b) => (
						<tr>
							<th scope="row">{name(b)}</th>
							<td>{b.count}</td>
							<td>{pct(b.count)}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</details>
</figure>

<style>
	.chart {
		margin: 0;
	}

	.plot {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: 1fr;
		gap: 2px;
		height: 12rem;
		border-bottom: 1px solid var(--line);
	}

	.col {
		display: grid;
		grid-template-rows: 1fr auto;
		min-width: 0;
	}

	.bar-area {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		align-items: stretch;
	}

	.bar {
		all: unset;
		position: relative;
		display: block;
		background: var(--chart);
		border-radius: 4px 4px 0 0;
		cursor: default;
	}

	/* Hit target larger than the mark: the whole column. */
	.bar::before {
		content: '';
		position: absolute;
		inset: -12rem 0 0;
	}

	.bar:hover,
	.bar:focus-visible {
		filter: brightness(1.15);
		outline: none;
	}

	.bar:focus-visible {
		box-shadow: 0 0 0 3px var(--focus);
	}

	.tip {
		position: absolute;
		z-index: 5;
		bottom: calc(100% + 0.5rem);
		left: 50%;
		transform: translateX(-50%);
		display: none;
		white-space: nowrap;
		padding: 0.4rem 0.6rem;
		border-radius: 0.4rem;
		background: var(--ink);
		color: var(--bg);
		font-size: var(--step--1);
		line-height: 1.3;
		text-align: center;
		pointer-events: none;
	}

	.tip strong {
		display: block;
	}

	.bar:hover .tip,
	.bar:focus-visible .tip {
		display: block;
	}

	.direct {
		align-self: center;
		font-size: var(--step--1);
		font-weight: 700;
		margin-bottom: 0.2rem;
	}

	.tick {
		text-align: center;
		font-size: 0.75rem;
		color: var(--muted);
		padding-top: 0.3rem;
	}

	figcaption {
		font-size: var(--step--1);
		margin-top: 0.5rem;
	}

	details {
		margin-top: 0.5rem;
		font-size: var(--step--1);
	}

	summary {
		cursor: pointer;
		color: var(--muted);
	}

	table {
		margin-top: 0.5rem;
		border-collapse: collapse;
	}

	th,
	td {
		padding: 0.2rem 1rem 0.2rem 0;
		text-align: left;
		font-weight: 400;
	}

	thead th {
		color: var(--muted);
	}
</style>

---
import { posterUrl, type Pack } from '../lib/data';

interface Props {
	pack: Pack;
}
const { pack: p } = Astro.props;
---

<a class="pack" href={p.url}>
	<span class="cover">
		<span class="collage" aria-hidden="true">
			{p.covers.map((c) => <img src={posterUrl(c.poster, 'w154')} alt="" width="154" height="231" loading="lazy" />)}
		</span>
		<span class="label">{p.label}</span>
	</span>
	<span class="muted meta">{p.from ? `Episodes ${p.from}–${p.to}` : `${p.episodes} episodes`}</span>
</a>

<style>
	.pack {
		display: grid;
		gap: 0.5rem;
		text-decoration: none;
	}

	/* A box-set cover: four posters with the year printed over a dark fade. */
	.cover {
		position: relative;
		display: block;
		border-radius: 0.6rem;
		overflow: hidden;
		box-shadow: 0 0 0 1px var(--line);
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.cover::after {
		content: '';
		position: absolute;
		inset: 45% 0 0;
		background: linear-gradient(transparent, rgb(8 6 20 / 0.92));
		pointer-events: none;
	}

	.pack:hover .cover,
	.pack:focus-visible .cover {
		transform: translateY(-4px);
		box-shadow:
			0 0 0 2px var(--brand),
			0 14px 28px rgb(0 0 0 / 0.35);
	}

	@media (prefers-reduced-motion: reduce) {
		.cover {
			transition: none;
		}
		.pack:hover .cover,
		.pack:focus-visible .cover {
			transform: none;
		}
	}

	.collage {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2px;
		aspect-ratio: 2 / 3;
		background: var(--bg);
	}

	.collage img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	/* Fewer than four posters: let the first fill the space. */
	.collage img:only-child {
		grid-column: 1 / -1;
		grid-row: 1 / 3;
	}

	.label {
		position: absolute;
		z-index: 1;
		left: 0.75rem;
		right: 0.75rem;
		bottom: 0.6rem;
		font-family: var(--font-display);
		font-weight: 900;
		font-size: var(--step-3);
		line-height: 0.95;
		color: #fff;
		text-shadow: 0 2px 12px rgb(0 0 0 / 0.6);
	}

	.meta {
		font-size: var(--step--1);
	}
</style>

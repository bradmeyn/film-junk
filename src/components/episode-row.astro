---
import { averageRating, episodeHref, episodeLabel, formatDate, type Episode } from '../lib/data';
import Stars from './stars.astro';

interface Props {
	episode: Episode;
	note?: string;
}
const { episode: e, note } = Astro.props;
const avg = averageRating(e.reviews);
const label = e.kind === 'regular' && e.number ? String(e.number) : { premium: 'Premium', patreon: 'Patreon', bonus: 'Bonus', regular: 'Episode' }[e.kind];
---

<li class="row">
	<span class="sticker" data-kind={e.kind} title={episodeLabel(e)}>{label}</span>
	<div>
		<a class="title" href={episodeHref(e)}>{e.title}</a>
		<div class="meta muted">
			<time datetime={e.date}>{formatDate(e.date, e.dateApprox)}</time>
			{avg !== null && <Stars score={avg} label="Average rating" />}
			{note && <span>{note}</span>}
		</div>
	</div>
</li>

<style>
	.row {
		display: grid;
		grid-template-columns: 5.5rem 1fr;
		gap: 1rem;
		align-items: start;
		padding-block: 0.75rem;
		border-bottom: 1px solid var(--line);
	}
	.sticker {
		justify-self: start;
		font-size: var(--step-1);
	}

	@media (max-width: 30rem) {
		.row {
			grid-template-columns: 4.25rem 1fr;
			gap: 0.75rem;
		}

		.sticker {
			font-size: var(--step-0);
		}
	}
	.title {
		font-weight: 700;
		text-decoration: none;
		color: var(--ink);
	}
	.title:hover {
		text-decoration: underline;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		font-size: var(--step--1);
	}
</style>

---
import { episodeHref, episodeLabel, formatDate, leadPoster, posterUrl, type Episode } from '../lib/data';
import Stars from './stars.astro';
import { episodeTile, TILE_ICONS } from '../lib/episode-tile';

interface Props {
	episode: Episode;
	note?: string;
	// In a list that's all one kind (New on Patreon), the badge says nothing new.
	hideKind?: boolean;
}
const { episode: e, note, hideKind } = Astro.props;
const rated = (e.reviews ?? []).filter((r) => r.ratings.length);
const label = e.kind === 'regular' && e.number ? String(e.number) : { premium: 'Premium', patreon: 'Patreon', bonus: 'Bonus', regular: 'Episode' }[e.kind];
// Without the kind badge, the lead film's poster takes its place (What We Watched), else the series icon.
const poster = hideKind ? posterUrl(leadPoster(e), 'w154') : null;
const [icon, series] = episodeTile(e.title, e.kind);
---

<li class:list={['row', { 'no-kind': hideKind }]}>
	{
		poster ? (
			<img class="poster" src={poster} alt="" width="154" height="231" loading="lazy" />
		) : hideKind ? (
			<span class="icon" data-kind={e.kind} title={series} aria-hidden="true">
				<svg viewBox="0 0 24 24">
					<path d={TILE_ICONS[icon]} />
					{icon === 'fj' && (
						<text x="12" y="17.6" text-anchor="middle">
							FJ
						</text>
					)}
				</svg>
			</span>
		) : (
			<span class="sticker" data-kind={e.kind} title={episodeLabel(e)}>
				{label}
			</span>
		)
	}
	<div>
		<a class="title" href={episodeHref(e)}>{e.title}</a>
		<div class="meta muted">
			<time datetime={e.date}>{formatDate(e.date, e.dateApprox)}</time>
			{note && <span>{note}</span>}
			{hideKind && e.links.patreon && <a href={e.links.patreon}>Listen on Patreon</a>}
		</div>
		{
			rated.map((r) => (
				<div class="ratings">
					{rated.length > 1 && <span class="muted">{r.title}</span>}
					{r.ratings.map((x) => (
						<span class="rating">
							{x.host} <Stars score={x.score} outOf={x.outOf} />
						</span>
					))}
				</div>
			))
		}
	</div>
</li>

<style>
	.row {
		display: grid;
		grid-template-columns: 5.5rem 1fr;
		gap: 1rem;
		align-items: start;
		padding-block: 0.75rem;
		border-bottom: 1px solid var(--line);
	}
	.row.no-kind {
		grid-template-columns: 2.75rem 1fr;
		gap: 0.85rem;
	}

	.poster {
		width: 100%;
		height: auto;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		border-radius: var(--radius);
	}

	/* The series icon on a tinted square, as on the episodes list's tiles. */
	.icon {
		display: grid;
		place-items: center;
		aspect-ratio: 1;
		border-radius: var(--radius);
		background: linear-gradient(160deg, color-mix(in srgb, var(--accent) 22%, var(--surface)), var(--surface));
		color: var(--accent);
	}

	.icon[data-kind='bonus'],
	.icon[data-kind='regular'] {
		background: linear-gradient(160deg, color-mix(in srgb, var(--star) 20%, var(--surface)), var(--surface));
		color: var(--star);
	}

	.icon svg {
		width: 1.5rem;
		height: 1.5rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.icon text {
		fill: currentColor;
		stroke: none;
		font-family: var(--font-body);
		font-size: 5.5px;
		font-weight: 800;
	}
	.sticker {
		justify-self: start;
		font-size: var(--step-1);
	}

	@media (max-width: 30rem) {
		.row {
			grid-template-columns: 4.25rem 1fr;
			gap: 0.75rem;
		}

		.sticker {
			font-size: var(--step-0);
		}
	}
	.title {
		font-weight: 700;
		text-decoration: none;
		color: var(--ink);
	}
	.title:hover {
		text-decoration: underline;
	}
	.ratings {
		display: flex;
		flex-wrap: wrap;
		gap: 0.15rem 1rem;
		margin-top: 0.2rem;
		font-size: var(--step--1);
	}
	.rating {
		font-weight: 600;
		white-space: nowrap;
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		font-size: var(--step--1);
	}
</style>

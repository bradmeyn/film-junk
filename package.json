{
  "name": "film-junk",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "data:fetch": "node --env-file-if-exists=.env scripts/fetch-sources.ts",
    "data:build": "node scripts/build-data.ts",
    "data": "npm run data:fetch && npm run data:build && npm run data:tmdb && npm run data:build",
    "data:tmdb": "node --env-file-if-exists=.env scripts/fetch-tmdb.ts",
    "typecheck": "astro check && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "astro": "^7.3.5",
    "svelte": "^5.57.1",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.19.1"
  }
}
